---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: mycronjob
spec:
  schedule: "* * * * *"
  jobTemplate:
    spec:
      template:
        metadata:
          name: mypod
          labels:
            env: test
        spec:
          containers:
            - name: mycont
              image: nginx
              command: ["/bin/bash","-c","sudo apt update -y; sudo apt install git -y; sleep 10"]
          restartPolicy: Never

